{
  "expo": {
    "name": "UCLL Mobile Starter",
    "slug": "ucll-mobile-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ucllstarter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
      "web": {
        "bundler": "metro",
        "output": "single",
        "favicon": "./public/PillzLogo.png"
      },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
